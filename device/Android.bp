soong_config_module_type {
    name: "camera_rockchip_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "camera_rockchip",
    variables: [
        "camera_aidl_version",
    ],
    bool_variables: [
        "osd",
        "virtual",
    ],
    properties: [
        "cflags",
        "defaults",
        "shared_libs",
        "static_libs"
    ],
}
soong_config_string_variable {
    name: "camera_aidl_version",
    values: [
        "v2",
        "v3",
    ],
}

camera_rockchip_cc_defaults{
    name: "rockchip_camera_device_aidl_lib_default",
    soong_config_variables:{
        camera_aidl_version:{
            conditions_default:{
                shared_libs: [
                    "android.hardware.camera.common-V1-ndk",
                    "android.hardware.camera.device-V2-ndk",
                ],
                static_libs: [
                    "android.hardware.camera.common-V1-ndk",
                    "android.hardware.camera.device-V2-ndk",
                    "android.hardware.camera.provider-V2-ndk",
                ],
            },
            v2: {
                shared_libs: [
                    "android.hardware.camera.common-V1-ndk",
                    "android.hardware.camera.device-V2-ndk",
                ],
                static_libs: [
                    "android.hardware.camera.common-V1-ndk",
                    "android.hardware.camera.device-V2-ndk",
                    "android.hardware.camera.provider-V2-ndk",
                ],
            },
            v3: {
                cflags: ["-DCAMERA_V3_SUPPORT"],
                shared_libs: [
                    "android.hardware.camera.common-V1-ndk",
                    "android.hardware.camera.device-V3-ndk",
                ],
                static_libs: [
                    "android.hardware.camera.device-V3-ndk",
                    "android.hardware.camera.provider-V3-ndk",
                ],
            },
        },
        osd: {
            cflags: ["-DOSD_ENABLE"],
        },
        virtual: {
            cflags: ["-DCAMERA_SUPPORT_VIRTUAL"],
        },
    }

}
cc_library_shared {
    name: "camera.device-external-impl-rk",
    defaults: ["rockchip_camera_device_aidl_lib_default"],
    proprietary: true,
    srcs: [
        "ExternalCameraDevice.cpp",
        "ExternalCameraDeviceSession.cpp",
        "ExternalCameraOfflineSession.cpp",
        "ExternalCameraUtils.cpp",
        "metadata_utils.cpp",
        "convert.cpp",
        "HandleImporter.cpp",
        "RgaCropScale.cpp",
        "osd.cpp"
    ],
    cflags: [
        "-Wno-error",
        "-DRK_DEVICE",
        "-DRK_HW_JPEG_DECODER",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "android.hardware.graphics.allocator@4.0",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "libbinder_ndk",
        "libcamera_metadata",
        "libcutils",
        "libexif",
        "libfmq",
        "libprocessgroup",
        "libgralloctypes",
        "libhardware",
        "libhidlbase",
        "libhidlmemory",
        "libjpeg",
        "liblog",
        "libsync",
        "libtinyxml2",
        "libutils",
        "libyuv",
        "libui",
        "librga",
        "libhwjpeg",
        "libmpp",
        "libpng",
        "libz",
        "libiep_vehicle",
    ],
    static_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.camera.common@1.0-helper",
        "libaidlcommonsupport",
        "libft2.nodep"
    ],
    header_libs: [
        "media_plugin_headers",
        "libhardware_rockchip_headers",
        "libhardware_headers",
        "libiep_headers",
    ],
    local_include_dirs: [
        "include",
    ],
    include_dirs: [
        "hardware/rockchip/librga",
        "hardware/rockchip/libhwjpeg/inc",
        "hardware/rockchip/libhwjpeg/inc/mpp_inc",
        "hardware/rockchip/libiep/include",
        "external/libdrm/include/drm",
    ],
    export_include_dirs: [
        ".",
        "include",
    ],
}


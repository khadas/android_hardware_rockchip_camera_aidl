cc_library_shared {
    name: "libdata_bridge",
    srcs: ["data_bridge.cpp"],
    header_libs: [
        "jni_headers",
        "libhardware_rockchip_headers",
    ],
    include_dirs: [
        "hardware/rockchip/librga",
    ],
    shared_libs: [
        "libbase",
        "libandroid",
        "liblog",
        "libutils",
        "libcutils",
        "libnativehelper",
        "libhidlbase",
        "libui",
        "librga",
        "rockchip.hardware.hdmi@1.0",
    ],
    cflags: [
        "-Wall",
        "-Wno-error",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    sanitize: {
        scs: true,
    },
}
